{
  "name": "playwright-interview-prep",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript interview prep",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "codegen": "playwright codegen https://www.saucedemo.com",
    "report": "playwright show-report",
    "trace": "playwright show-trace",
    "lint": "tsc --noEmit",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:setup": "playwright test --project=setup",
    "install:browsers": "playwright install --with-deps",
    "codegen:auth": "playwright codegen --save-storage=playwright/.auth/user.json https://www.saucedemo.com"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "dotenv": "^16.4.0"
  }
}
